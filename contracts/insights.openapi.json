{
  "openapi": "3.1.0",
  "info": {
    "title": "ForeKast Insights — propuesta",
    "version": "0.1.0",
    "description": "Contrato de diseño v1. No hay servicio desplegado. Invariantes temporales y de evidencia en docs/PYTHON_AI.md."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Laboratorio local futuro. No usar HTTP en despliegue."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/weather-insights": {
      "post": {
        "operationId": "generateWeatherInsights",
        "summary": "Generar insights desde un snapshot reducido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insight o abstención válida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsightResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incompatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload excede 32 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validación fallida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Cuota excedida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos de espera o fecha HTTP",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sesión emitida por el backend al habilitar acceso remoto; nunca clave LLM en APK."
      }
    },
    "schemas": {
      "InsightRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "requestId",
          "snapshotId",
          "fetchedAt",
          "timezone",
          "locale",
          "mode",
          "hours"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "locale": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "day_summary",
              "walk_window"
            ]
          },
          "hours": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Hour"
            }
          },
          "walkDurationMinutes": {
            "type": "integer",
            "enum": [
              30,
              60,
              120
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "walk_window"
                }
              }
            },
            "then": {
              "required": [
                "walkDurationMinutes"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "walkDurationMinutes"
                ]
              }
            }
          }
        ]
      },
      "InsightResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "requestId",
          "snapshotId",
          "status",
          "generatedAt",
          "expiresAt",
          "method",
          "insights",
          "limitations"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_insight"
            ]
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "enum": [
              "rules",
              "llm"
            ]
          },
          "insights": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Insight"
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "insights": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "insights": {
                  "maxItems": 0
                },
                "limitations": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "Hour": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "temperatureC",
          "precipitationProbabilityPct"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "temperatureC": {
            "type": [
              "number",
              "null"
            ]
          },
          "precipitationProbabilityPct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "field"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "field": {
            "type": "string",
            "enum": [
              "temperatureC",
              "precipitationProbabilityPct"
            ]
          }
        }
      },
      "Insight": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "payload_too_large",
              "validation_error",
              "rate_limited",
              "service_unavailable"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
